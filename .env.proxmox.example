# ==============================================================================
# PaceFriend — Configuración de Producción para Contenedor LXC en Proxmox
# Copia este archivo a `.env` en la raíz del proyecto: cp .env.proxmox.example .env
# ==============================================================================

# URL pública HTTPS de tu dominio en Cloudflare (sin barra final)
APP_URL=https://pacefriend.tudominio.com
APP_ENV=production
APP_DEBUG=false
# Se autogenera con deploy/proxmox/setup-lxc.sh (formato base64:...)
APP_KEY=
# Puerto local LAN opcional por si accedes también desde tu red doméstica
APP_PORT=8080

# PostgreSQL 17 interno
DB_DATABASE=pacefriend
DB_USERNAME=pacefriend
DB_PASSWORD=cambia_esta_clave_segura

# Cloudflare Zero Trust Tunnel
# Descomenta COMPOSE_PROFILES=tunnel cuando pegues tu CLOUDFLARE_TUNNEL_TOKEN
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Motor de Voz Natural IA (local | elevenlabs)
PACEFRIEND_VOICE_DRIVER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Motor Narrativo para Informe PRO (local | gemini | openai)
PACEFRIEND_LLM_DRIVER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Garage 61 OAuth2 (para vinculación en 1 clic de compañeros de equipo y usuarios)
GARAGE61_CLIENT_ID=
GARAGE61_CLIENT_SECRET=
# Opcional: por defecto usa ${APP_URL}/settings/garage61/callback
GARAGE61_REDIRECT_URI=
