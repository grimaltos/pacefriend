APP_NAME=PaceFriend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL 17 (matches docker-compose.yml at repository root)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pacefriend
DB_USERNAME=pacefriend
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# PaceFriend AI Voice Synthesis (local | elevenlabs)
PACEFRIEND_VOICE_DRIVER=local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# PaceFriend PRO Report Narrator (local | gemini | openai)
PACEFRIEND_LLM_DRIVER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Garage 61 OAuth2
GARAGE61_CLIENT_ID=
GARAGE61_CLIENT_SECRET=
GARAGE61_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
